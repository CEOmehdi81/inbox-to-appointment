generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Listing {
  id        String   @id // keep your "portal:listId" if you want
  agencyId  String   // ✅ tenant ownership

  title     String
  portal    String
  location  String?
  price     Float?
  status    String?
  listed_at DateTime?

  leads     Lead[]

  @@index([agencyId, portal])
  @@index([agencyId, listed_at])
  @@unique([agencyId, id], name: "uniq_listing_agency_id") // makes tenant scoping explicit
}

model Lead {
  id          String   @id // sha256(portal|listing_id|created_at|source)

  agencyId    String // ✅ tenant ownership

  listing_id  String
  portal      String
  lead_source String
  created_at  DateTime

  person_id String?
  person    LeadPerson? @relation(fields: [person_id], references: [id])

  listing Listing @relation(fields: [listing_id], references: [id])

  details LeadDetails? @relation("LeadToLeadDetails")

  // Option B history
  matches LeadPersonMatch[]

  // Link raw emails -> lead
  sources LeadEmailSource[]

  @@index([agencyId, created_at])
  @@index([agencyId, portal, created_at])
  @@index([agencyId, listing_id, created_at])
  @@index([agencyId, person_id])
}

model Spend {
  id       String   @id @default(cuid())
  agencyId String   // ✅ tenant ownership

  portal String
  month  String // "YYYY-MM"
  amount Decimal

  @@unique([agencyId, portal, month], name: "uniq_spend_agency_portal_month")
  @@index([agencyId, month])
}

model MetricsMonthly {
  agencyId String
  month    String
  portal   String
  leads    Int
  cpl      Float?

  @@id([agencyId, month, portal])
}

model LeadDetails {
  lead_id String @id
  agencyId String // ✅ tenant ownership

  lead Lead @relation("LeadToLeadDetails", fields: [lead_id], references: [id])

  language          String?
  contact_name      String?
  profile           String?
  age               Int?
  has_guarantor     Boolean?
  budget_monthly    Int?
  budget_currency   String?
  move_in_timing    String?
  city_or_area      String?
  visit_preferences String?
  motivation_level  Int?
  motivation_bucket String?
  contact_email     String?
  contact_phone     String?
  listing_reference String?
  listing_url       String?
  summary           String?
  raw_text          String?
  email_subject     String?

  ingest_workflow String?

  @@index([agencyId])
}

model LeadPerson {
  id        String @id @default(cuid())
  agencyId  String // ✅ tenant ownership (required for privacy)

  norm_name  String?
  norm_email String?
  norm_phone String?

  display_name  String?
  display_email String?
  display_phone String?

  total_contacts       Int     @default(0)
  listings_count       Int     @default(0)
  suspicious_duplicate Boolean @default(false)

  leads         Lead[]
  conversations Conversation[]
  matches       LeadPersonMatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId, norm_email])
  @@index([agencyId, norm_phone])
}

enum MatchLevel {
  CONFIRMED
  PROBABLE
  UNLINKED
}

model LeadPersonMatch {
  id        String   @id @default(cuid())
  agencyId  String

  lead_id   String
  person_id String

  matchScore   Int
  matchLevel   MatchLevel
  matchReasons Json

  matchedAt DateTime @default(now())
  matchedFromEmailMessageId String?
  isActive Boolean @default(true)

  lead   Lead       @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  person LeadPerson @relation(fields: [person_id], references: [id], onDelete: Cascade)

  @@index([agencyId, lead_id])
  @@index([agencyId, person_id])
  @@index([agencyId, isActive])
}

//
// Canonical raw emails table (replaces EmailMessageSeen + GmailForwardedMessage long-term)
//
model EmailMessage {
  id        String   @id @default(cuid())

  agencyId  String
  inboxId   String
  provider  String   // "GMAIL"

  messageId String
  threadId  String?
  from      String?
  to        String?
  subject   String?
  bodyText  String?
  bodyHtml  String?
  receivedAt DateTime

  contentHash String
  processedAt DateTime?

  createdAt DateTime @default(now())

  leadSources LeadEmailSource[]

  @@unique([provider, agencyId, inboxId, messageId], name: "uniq_email_msg")
  @@index([agencyId, inboxId, receivedAt])
  @@index([agencyId, contentHash])
}

model LeadEmailSource {
  id            String   @id @default(cuid())
  agencyId      String

  leadId        String
  emailMessageId String

  createdAt DateTime @default(now())

  lead         Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  emailMessage EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@unique([agencyId, leadId, emailMessageId], name: "uniq_lead_email_source")
  @@index([agencyId, leadId])
  @@index([agencyId, emailMessageId])
}

model LeadPersonMatchEvent {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())

  lead_id   String
  person_id String

  score           Float
  email_exact     Boolean
  phone_exact     Boolean
  name_similarity Float
  same_listing    Boolean
  same_portal     Boolean
  decision        String

  @@index([person_id])
  @@index([lead_id])
}

model Conversation {
  id                 String @id @default(cuid())
  channel            String
  external_thread_id String

  person_id String?
  person    LeadPerson? @relation(fields: [person_id], references: [id])

  status             String  @default("active")
  last_stage         String?
  last_score         Float?
  last_snapshot_json Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  messages ConversationMessage[]

  @@index([channel, external_thread_id])
  @@index([person_id])
}

model ConversationMessage {
  id              String       @id @default(cuid())
  conversation_id String
  conversation    Conversation @relation(fields: [conversation_id], references: [id])

  role String
  text String
  ts   DateTime @default(now())

  @@index([conversation_id, ts])
}

model WhatsAppConnection {
  id String @id @default(cuid())

  ownerId String
  phoneNumber String
  phoneNumberId String
  wabaId        String

  accessToken   String
  webhookSecret String

  status String
  label  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([phoneNumber])
}

enum ChannelType {
  WHATSAPP
  EMAIL
  PORTAL
  WEBFORM
  CALL_TRACKING
}

model Channel {
  id        String      @id @default(cuid())
  agencyId  String
  name      String
  type      ChannelType
  isActive  Boolean     @default(true)
  config    Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([agencyId])
  @@unique([agencyId, type])
}
model EmailIntegration {
  id String @id @default(cuid())

  // tenant
  agencyId String

  // provider
  provider String // "GMAIL"

  // inbox identity (must be non-null if you want multiple per agency)
  email String

  status String @default("PENDING")
  // PENDING | CONNECTED | VERIFIED | RESTRICTED | ERROR

  // OAuth secrets (encrypted)
  accessTokenEnc  String
  refreshTokenEnc String?

  scope        String?
  tokenType    String?
  expiryDateMs BigInt?

  // Gmail specific
  labelId   String?
  labelName String @default("HOMI/Leads")

  verifiedAt DateTime?
  lastError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
  @@index([agencyId])
  @@unique([agencyId, provider, email], name: "uniq_agency_provider_email")
}
//
// Legacy tables (keep for now, migrate later)
//
model GmailForwardedMessage {
  id         String   @id @default(cuid())

  agencyId   String
  inboxEmail String
  messageId  String
  threadId   String?
  receivedAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([agencyId, inboxEmail, messageId], name: "uniq_gmail_forwarded")
  @@index([agencyId, inboxEmail])
}

model EmailMessageSeen {
  id         String   @id @default(cuid())
  provider   String
  agencyId   String
  inboxEmail String
  messageId  String
  createdAt  DateTime @default(now())

  @@unique([provider, agencyId, inboxEmail, messageId])
  @@index([agencyId, inboxEmail])
}